---
import { Image } from 'astro:assets';
import { SCHOOLS } from '../data/schools';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  slug: string;
  /**
   * Height in pixels. Crests are normalised by HEIGHT, never fitted into a
   * square: the real artwork ranges from 0.65:1 (Stanford's tree) to 5.71:1
   * (the Carnegie Mellon wordmark), and a square box shrinks the wide ones to
   * nothing. Equal height is the standard treatment for a mixed logo row.
   */
  height?: number;
  class?: string;
}

const { slug, height: baseHeight = 32, class: className } = Astro.props;

const school = SCHOOLS[slug];
if (!school) {
  throw new Error(`No school registered under "${slug}" — see src/data/schools.ts`);
}

const height = Math.round(baseHeight * (school.scale ?? 1));

const lang = getLangFromUrl(Astro.url);
const alt = lang === 'zh' ? `${school.nameZh}校徽` : `${school.name} logo`;

/*
  Anything dropped into src/assets/crests/ is picked up here, so replacing a
  crest is a matter of saving a file. Eager so it resolves at build time.
*/
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/crests/*.{png,jpg,jpeg,webp,svg}',
  { eager: true },
);

const match = Object.entries(files).find(
  ([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === slug,
);
---

{
  match ? (
    <span class:list={['inline-flex items-center', className]}>
      {/*
        Only the height is given. Passing a width as well makes the image
        pipeline resize raster sources to exactly those dimensions and crop
        the overflow — which silently sliced the Carnegie Mellon and Stanford
        marks down to one word each. SVGs pass through untouched, so the bug
        was invisible until the first PNG crest arrived.
      */}
      <Image
        src={match[1].default}
        alt={alt}
        height={height}
        class="w-auto"
        style={`height:${height}px`}
      />
    </span>
  ) : (
    <span
      class:list={['grid shrink-0 place-items-center rounded-full', className]}
      style={`width:${height}px;height:${height}px;background:${school.color}`}
      role="img"
      aria-label={alt}
    >
      <span
        class="font-semibold text-paper"
        style={`font-family: var(--font-display); font-size:${Math.round(height * (school.monogram.length > 2 ? 0.26 : 0.34))}px`}
      >
        {school.monogram}
      </span>
    </span>
  )
}
