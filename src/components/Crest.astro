---
import { Image } from 'astro:assets';
import { SCHOOLS } from '../data/schools';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  slug: string;
  /** Rendered box size in pixels. */
  size?: number;
  class?: string;
}

const { slug, size = 48, class: className } = Astro.props;

const school = SCHOOLS[slug];
if (!school) {
  throw new Error(`No school registered under "${slug}" — see src/data/schools.ts`);
}

const lang = getLangFromUrl(Astro.url);
const alt = `${lang === 'zh' ? school.nameZh : school.name} crest`;

/*
  Anything dropped into src/assets/crests/ is picked up here, so adding the real
  artwork is a matter of saving a file — no code change. Eager so the lookup
  happens at build time and nothing ships to the client.
*/
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/crests/*.{png,jpg,jpeg,webp,svg}',
  { eager: true },
);

const match = Object.entries(files).find(
  ([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === slug,
);
---

{
  match ? (
    <Image
      src={match[1].default}
      alt={alt}
      width={size}
      height={size}
      class:list={['shrink-0 object-contain', className]}
    />
  ) : (
    /* Placeholder until the real crest is supplied. Deliberately typographic:
       it stands in for the crest without imitating it. */
    <span
      class:list={['grid shrink-0 place-items-center rounded-full', className]}
      style={`width:${size}px;height:${size}px;background:${school.color}`}
      role="img"
      aria-label={alt}
    >
      <span
        class="font-semibold text-paper"
        style={`font-family: var(--font-display); font-size:${Math.round(size * (school.monogram.length > 2 ? 0.26 : 0.34))}px; letter-spacing:0.02em`}
      >
        {school.monogram}
      </span>
    </span>
  )
}
