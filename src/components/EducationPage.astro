---
import Crest from './Crest.astro';
import { EDUCATION, COURSEWORK, OPEN_COURSES, FOUNDATIONS } from '../consts';
import { getLangFromUrl, useTranslations, localizePath, localize } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="px-5 pt-9 sm:px-8">
  <p class="kicker text-center" data-enter style="--enter: 0">{t('edu.section')}</p>

  <h1 class="deck-xl mt-3 text-center text-balance" data-enter style="--enter: 1">
    {t('edu.title')}
  </h1>

  <div class="rule-double mt-6"></div>

  <p
    class="standfirst mx-auto mt-6 max-w-2xl text-center text-pretty"
    data-enter
    style="--enter: 2"
  >
    {t('edu.standfirst')}
  </p>
</section>

<!-- The degree -->
<section class="px-5 pt-10 sm:px-8">
  <div class="reversed px-4 py-2.5">
    <h2 class="deck-md">{t('edu.degree')}</h2>
  </div>

  {
    EDUCATION.map((raw) => {
      const item = localize(raw, lang);
      return (
        <div class="mt-7 grid gap-6 lg:grid-cols-[1fr_1fr] lg:gap-12" data-reveal>
          <div class="flex items-start gap-5">
            <Crest slug={item.crest} height={78} class="mt-1 shrink-0" />

            <div>
              <p class="kicker">{item.period}</p>
              <h3 class="deck-lg mt-2">{item.school}</h3>
              <p class="standfirst mt-3">{item.degree}</p>
            </div>
          </div>

          <div>
            <p class="dropcap text-sm leading-relaxed text-pretty">{item.detail}</p>
          </div>
        </div>
      );
    })
  }

  <div class="rule-thin mt-8 pt-6" data-reveal>
    <p class="kicker">{t('edu.coursework')}</p>
    <ul class="mt-4 flex flex-wrap gap-x-2 gap-y-2">
      {COURSEWORK.map((course) => <li class="cell px-3 py-1.5 text-sm">{course[lang]}</li>)}
    </ul>
  </div>
</section>

<!-- Open courseware -->
<section class="px-5 pt-12 sm:px-8">
  <div class="reversed px-4 py-2.5">
    <h2 class="deck-md">{t('edu.open')}</h2>
  </div>

  <p class="standfirst mt-5 max-w-3xl text-pretty" data-reveal>
    {t('edu.openStandfirst')}
  </p>

  <div class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2">
    {
      OPEN_COURSES.map((raw) => {
        const course = localize(raw, lang);
        return (
          <article
            class="rule-thin grid gap-x-5 gap-y-3 pt-5 sm:grid-cols-[7rem_1fr]"
            data-reveal
          >
            {/*
              Fixed 7rem column rather than an inline flex row: the marks run
              from 69px to 106px wide, so a shrink-to-fit column would start
              every card's type at a different x and the grid would read as
              misaligned. 7rem clears the widest of them.
            */}
            <Crest slug={course.crest} height={30} class="self-start" />

            <div class="min-w-0">
              <div class="flex items-baseline justify-between gap-4">
                <p class="kicker">
                  {course.school} · {course.code}
                </p>
                <p class="byline">{course.year}</p>
              </div>

              <h3 class="deck-sm mt-1.5">{course.title}</h3>

              <p class="mt-3 text-sm leading-relaxed text-pretty">{course.note}</p>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<!-- Fundamentals -->
<section class="px-5 pt-12 sm:px-8">
  <div class="reversed px-4 py-2.5">
    <h2 class="deck-md">{t('edu.fundamentals')}</h2>
  </div>

  <p class="standfirst mt-5 max-w-3xl text-pretty" data-reveal>
    {t('edu.fundamentalsStandfirst')}
  </p>

  <div class="mt-8 columns-1 gap-10 sm:columns-2 lg:columns-3">
    {
      FOUNDATIONS.map((block) => (
        <div class="mb-8 break-inside-avoid" data-reveal>
          <h3 class="deck-sm">{block.area[lang]}</h3>
          <ul class="mt-3 space-y-2">
            {block.items.map((item) => (
              <li class="flex gap-2.5 text-sm leading-relaxed">
                <span class="mt-2 h-px w-3 shrink-0 bg-ink" aria-hidden="true" />
                <span>{item[lang]}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<section class="px-5 pt-8 sm:px-8">
  <div class="rule-double"></div>
  <div class="flex flex-wrap items-center justify-between gap-5 py-7">
    <h2 class="deck-md text-balance">{t('edu.cta')}</h2>
    <div class="flex flex-wrap gap-3">
      <a href={`${localizePath('/', lang)}#work`} class="btn-oval">{t('front.cta.work')}</a>
      <a href={localizePath('/stack', lang)} class="btn-oval">{t('front.cta.stack')}</a>
    </div>
  </div>
</section>
