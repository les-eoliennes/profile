---
import Crest from './Crest.astro';
import { EDUCATION, COURSEWORK, OPEN_COURSES } from '../consts';
import { getLangFromUrl, useTranslations, localizePath, localize } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const courseCategories = ['cs', 'ai', 'math', 'physics', 'econ', 'psych'] as const;
---

<section class="px-5 pt-9 sm:px-8">
  <p class="kicker text-center" data-enter style="--enter: 0">{t('edu.section')}</p>

  <h1 class="deck-xl mt-3 text-center text-balance" data-enter style="--enter: 1">
    {t('edu.title')}
  </h1>

  <div class="rule-double mt-6"></div>
</section>

<!-- Lead: statement on the left, subtitle and short essay on the right — same format as the front page's lead. -->
<section class="grid gap-7 px-5 py-8 sm:px-8 lg:grid-cols-[1.05fr_1fr] lg:gap-12">
  <div data-enter style="--enter: 2">
    <h2 class="deck-lg text-balance">{t('edu.headline')}</h2>
  </div>

  <div data-enter style="--enter: 3">
    <p class="standfirst">{t('edu.standfirst')}</p>

    <div class="columns-news mt-5 space-y-4 text-sm sm:columns-2">
      <p class="dropcap">{t('edu.body1')}</p>
      <p>{t('edu.body2')}</p>
    </div>
  </div>
</section>

<!-- The degree -->
<section class="px-5 pt-10 sm:px-8">
  <div class="reversed px-4 py-2.5">
    <h2 class="deck-md">{t('edu.degree')}</h2>
  </div>

  {
    EDUCATION.map((raw) => {
      const item = localize(raw, lang);
      return (
        <div class="mt-7" data-reveal>
          <div class="grid gap-6 lg:grid-cols-[1fr_1fr] lg:gap-12">
            <div class="degree-heading flex items-start gap-5">
              <Crest slug={item.crest} height={78} class="degree-crest mt-1 shrink-0" />

              <div>
                <p class="kicker">{item.period}</p>
                <h3 class="deck-lg mt-2">{item.school}</h3>
                <p class="standfirst mt-3 text-pretty">{item.degree}</p>
              </div>
            </div>

            {/*
              Always four in one row, never wrapping to a second row. This
              column is squeezed to half the page width from the lg
              breakpoint up, so the number size cannot stay at deck-lg (60px)
              the way the front-page stat strip uses it — that overflowed a
              quarter of this narrower column before. Sized down at each
              breakpoint instead of dropping to fewer columns: small on a
              stacked mobile column, largest in the mid-width range where the
              block still has the full page to itself (below the lg split),
              back down again once it is squeezed beside the school info.
            */}
            {item.rankings && (
              <dl class="school-rankings grid grid-cols-4">
                {item.rankings.map((r) => (
                  <div class="px-1 py-5 text-center sm:px-2" title={`${r.body[lang]} · ${r.year}`}>
                    <dd
                      class="text-xl leading-none font-black sm:text-4xl lg:text-3xl"
                      style="font-family: var(--font-display); letter-spacing: -0.018em"
                    >
                      {r.rank}
                    </dd>
                    <dt class="kicker mt-2">{r.short}</dt>
                  </div>
                ))}
              </dl>
            )}
          </div>

          <p class="dropcap mt-8 max-w-3xl text-sm leading-relaxed text-pretty">
            {item.detail}
          </p>
        </div>
      );
    })
  }

  <div class="rule-thin mt-8 pt-6" data-reveal>
    <p class="kicker">{t('edu.coursework')}</p>
    <ul class="mt-4 flex flex-wrap gap-x-2 gap-y-2">
      {COURSEWORK.map((course) => <li class="cell px-3 py-1.5 text-sm">{course[lang]}</li>)}
    </ul>
  </div>
</section>

<!-- Open courseware -->
<section class="px-5 pt-12 sm:px-8">
  <div class="reversed px-4 py-2.5">
    <h2 class="deck-md">{t('edu.open')}</h2>
  </div>

  <p class="standfirst mt-5 max-w-3xl text-pretty" data-reveal>
    {t('edu.openStandfirst')}
  </p>

  <div class="mt-7" data-course-tabs>
    <div class="course-tabs" data-course-tablist aria-label={t('edu.open')}>
      {courseCategories.map((category) => (
        <a
          id={`course-tab-${category}`}
          href={`#courses-${category}`}
          class="course-tab"
          data-course-tab={category}
          data-astro-reload
        >
          {t(`edu.category.${category}`)}
        </a>
      ))}
    </div>
    {courseCategories.map((category) => (
      <section id={`courses-${category}`} class="mt-6" data-course-panel={category}>
        <h3 class="deck-sm mb-5" data-course-heading>{t(`edu.category.${category}`)}</h3>
        <div class="grid gap-x-10 gap-y-8 lg:grid-cols-2">
          {
            OPEN_COURSES.filter((course) => course.category === category).map((raw) => {
              const course = localize(raw, lang);
              return (
                <article
                  class="course-card rule-thin grid content-start gap-x-5 gap-y-3 pt-5 sm:grid-cols-[7rem_1fr]"
                  data-reveal
                >
                  {/*
                    Fixed 7rem column rather than an inline flex row: the marks run
                    from 69px to 106px wide, so a shrink-to-fit column would start
                    every card's type at a different x and the grid would read as
                    misaligned. 7rem clears the widest of them.
                  */}
                  <Crest slug={course.crest} height={30} class="course-crest self-start" />

                  <div class="min-w-0">
                    <p class="course-meta kicker">
                      {course.school} · {course.code}
                    </p>

                    <h4 class="deck-sm mt-1.5">{course.title}</h4>
                  </div>
                  <p class="course-note text-sm leading-relaxed text-pretty sm:col-start-2">{course.note}</p>
                </article>
              );
            })
          }
        </div>
      </section>
    ))}
  </div>
</section>

<section class="px-5 pt-8 sm:px-8">
  <div class="rule-double"></div>
  <div class="flex flex-wrap items-center justify-between gap-5 py-7">
    <h2 class="deck-md text-balance">{t('edu.cta')}</h2>
    <div class="flex flex-wrap gap-3">
      <a href={`${localizePath('/', lang)}#work`} class="btn-oval">{t('front.cta.work')}</a>
      <a href={localizePath('/stack', lang)} class="btn-oval">{t('front.cta.stack')}</a>
    </div>
  </div>
</section>
