---
import { SITE, SOCIAL, TIMELINE } from '../consts';
import { getLangFromUrl, useTranslations, localize } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="px-5 pt-9 sm:px-8">
  <p class="kicker text-center" data-enter style="--enter: 0">{t('experience.section')}</p>

  <h1 class="deck-xl mt-3 text-center text-balance" data-enter style="--enter: 1">
    {t('experience.title')}
  </h1>

  <div class="rule-double mt-6"></div>
</section>

<section class="grid gap-8 px-5 py-8 sm:px-8 lg:grid-cols-[1fr_1.1fr] lg:gap-12">
  <div data-enter style="--enter: 2">
    <h2 class="deck-lg text-balance">{t('experience.headline')}</h2>
  </div>

  <div class="columns-news space-y-4 text-sm sm:columns-2" data-enter style="--enter: 3">
    <p class="dropcap">{t('experience.body1')}</p>
    <p>{t('experience.body2')}</p>
    <p>{t('experience.body3')}</p>
    <p>{t('experience.body4')}</p>
  </div>
</section>

<!-- Career -->
<section class="px-5 pt-6 sm:px-8">
  <div class="reversed px-4 py-2.5">
    <h2 class="deck-md">{t('experience.record')}</h2>
  </div>

  <div class="mt-7">
    {
      TIMELINE.map((raw) => {
        const item = localize(raw, lang);
        return (
          <div class="rule-thin grid gap-3 py-6 sm:grid-cols-[200px_1fr] sm:gap-8" data-reveal>
            <p class="kicker pt-1">{item.period}</p>
            <div>
              <h3 class="deck-sm">{item.title}</h3>
              <p class="byline mt-1.5">{item.org}</p>
              {item.detail && (
                <p class="mt-3 max-w-2xl text-sm leading-relaxed text-pretty">{item.detail}</p>
              )}
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<!-- Contact -->
<section class="px-5 pt-10 sm:px-8">
  <div class="rule-double"></div>
  <div class="flex flex-wrap items-center justify-between gap-5 py-8">
    <h2 class="deck-md text-balance">{t('experience.contact')}</h2>
    <div class="flex flex-wrap gap-3">
      <a href={`mailto:${SITE.email}`} class="btn-oval">{t('experience.email')}</a>
      {
        SOCIAL.map((s) => (
          <a href={s.href} target="_blank" rel="me noopener" class="btn-oval">
            {s.label}
          </a>
        ))
      }
    </div>
  </div>
</section>
