---
import { SITE, SOCIAL, NAV } from '../consts';
const year = new Date().getFullYear();
---

<!-- Apple 的页脚：浅灰底、极小字号、发丝分隔线 -->
<footer class="border-t border-line bg-bg-alt">
  <div class="mx-auto max-w-[980px] px-6 py-10 text-xs text-muted">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 border-b border-line pb-6">
      {
        NAV.map((item) => (
          <a href={item.href} class="transition-opacity hover:opacity-70">
            {item.label}
          </a>
        ))
      }
      <a href={`mailto:${SITE.email}`} class="transition-opacity hover:opacity-70">邮件</a>
      {
        SOCIAL.map((s) => (
          <a href={s.href} target="_blank" rel="me noopener" class="transition-opacity hover:opacity-70">
            {s.label}
          </a>
        ))
      }
    </div>

    <p class="pt-6">© {year} {SITE.name}。用 Astro 构建。</p>
  </div>
</footer>
