---
import ProjectCard from './ProjectCard.astro';
import TechMark from './TechMark.astro';
import { SITE, STATS } from '../consts';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';
import { getReports } from '../lib/reports';
import { TECH } from '../data/tech';

/*
  The front page in both editions. Everything visible comes through t(), so the
  two routes under pages/ are thin wrappers and the layout cannot drift apart.
*/
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const reports = await getReports(lang);
const [lead, ...rest] = reports;

// A handful of marks as a trailer for the stack page.
const trailer = ['go', 'rust', 'postgresql', 'kubernetes', 'redis', 'linux'];
---

<!-- Nameplate story -->
<section class="px-5 pt-8 sm:px-8">
  <p class="kicker text-center" data-enter style="--enter: 0">{t('front.kicker')}</p>

  <!--
    The name types itself in. The full string stays here in the markup so a
    reader without JavaScript still gets a heading; the script splits it up at
    runtime. No data-enter: the typing is its entrance.
  -->
  <h1 class="deck-xl mt-4 text-center text-balance" data-typewriter>{SITE.name}</h1>

  <div class="rule-double mt-6"></div>
</section>

<!-- Lead: statement type on the left, opening copy on the right -->
<section class="grid gap-7 px-5 py-8 sm:px-8 lg:grid-cols-[1.05fr_1fr] lg:gap-12">
  <div data-enter style="--enter: 2">
    <h2 class="deck-lg text-balance">{t('front.headline')}</h2>

    <div class="mt-6 flex flex-wrap gap-3">
      <a href="#work" class="btn-oval">{t('front.cta.work')}</a>
      <a href={localizePath('/stack', lang)} class="btn-oval">{t('front.cta.stack')}</a>
    </div>
  </div>

  <div data-enter style="--enter: 3">
    <p class="standfirst">{t('front.standfirst')}</p>

    <div class="columns-news mt-5 space-y-4 text-sm sm:columns-2">
      <p class="dropcap">{t('front.body1')}</p>
      <p>{t('front.body2')}</p>
    </div>
  </div>
</section>

<!-- Figures -->
<section class="px-5 sm:px-8">
  <div class="rule-thin grid grid-cols-2 sm:grid-cols-4">
    {
      STATS.map((stat) => (
        <div class="border-b border-rule px-2 py-5 text-center sm:border-b-0">
          <p class="deck-lg leading-none">{stat.value}</p>
          <p class="kicker mt-2">{t(stat.key)}</p>
        </div>
      ))
    }
  </div>
  <div class="rule-thin"></div>
</section>

<!-- Work -->
<section id="work" class="px-5 pt-10 sm:px-8">
  <div class="reversed px-4 py-2.5">
    <h2 class="deck-md">{t('work.heading')}</h2>
  </div>

  <div class="mt-8">
    {lead && <ProjectCard report={lead} index={0} lead />}
  </div>

  <div class="rule-thin mt-9 grid gap-8 pt-8 sm:grid-cols-2 sm:gap-10">
    {rest.map((report, i) => <ProjectCard report={report} index={i + 1} />)}
  </div>
</section>

<!-- Stack trailer -->
<section class="mt-12 px-5 sm:px-8">
  <div class="rule-double"></div>

  <div class="grid gap-6 py-8 lg:grid-cols-[1fr_auto] lg:items-center lg:gap-12">
    <div>
      <h2 class="deck-md text-balance">{t('trailer.heading')}</h2>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-pretty">{t('trailer.body', { n: TECH.length })}</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={localizePath('/stack', lang)} class="btn-oval">{t('trailer.cta.stack')}</a>
        <a href={localizePath('/education', lang)} class="btn-oval">
          {t('trailer.cta.education')}
        </a>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-6 lg:justify-end">
      {trailer.map((slug) => <TechMark slug={slug} class="h-8 w-auto sm:h-10" />)}
    </div>
  </div>
</section>
