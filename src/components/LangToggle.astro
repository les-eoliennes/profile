---
import { getLangFromUrl, useTranslations, alternatePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Every route exists in both editions, so the switch is always offered and
// always lands on the same page in the other language.
const href = alternatePath(Astro.url.pathname, lang);
---

<a
  href={href}
  hreflang={lang === 'zh' ? 'en' : 'zh-Hans'}
  aria-label={t('a11y.lang')}
  class="language-toggle kicker border border-rule px-2.5 py-1 transition-colors hover:bg-ink hover:text-paper"
>
  {t('lang.other')}
</a>
