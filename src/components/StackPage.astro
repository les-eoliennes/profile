---
import TechMark from './TechMark.astro';
import TechDialog from './TechDialog.astro';
import { TECH } from '../data/tech';
import { getLangFromUrl, useTranslations, localize } from '../i18n/utils';
import { tabsPerRow } from '../lib/tabs';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const categories = (['Languages', 'Data', 'Infrastructure', 'Observability', 'Web'] as const).filter(
  (category) => TECH.some((tech) => tech.category === category),
);
---

<section class="px-5 pt-9 sm:px-8">
  <p class="kicker text-center" data-enter style="--enter: 0">{t('stack.section')}</p>

  <h1 class="deck-xl mt-3 text-center text-balance" data-enter style="--enter: 1">
    {t('stack.title')}
  </h1>

  <div class="rule-double mt-6"></div>
</section>

<!-- Lead: statement on the left, subtitle and short essay on the right — same format as the front page and Education. -->
<section class="grid gap-7 px-5 py-8 sm:px-8 lg:grid-cols-[1.05fr_1fr] lg:gap-12">
  <div data-enter style="--enter: 2">
    <h2 class="deck-lg text-balance">{t('stack.headline')}</h2>
  </div>

  <div data-enter style="--enter: 3">
    <p class="standfirst">{t('stack.standfirst')}</p>

    <div class="columns-news mt-5 space-y-4 text-sm sm:columns-2">
      <p class="dropcap">{t('stack.body1')}</p>
      <p>{t('stack.body2')}</p>
    </div>
  </div>
</section>

<section class="px-5 sm:px-8">
  <!--
    A printer's ornament: the full set of marks running across the page.
    Decorative only — the listing underneath is the interface.

    The set is struck twice so the track can slide by exactly one set and
    loop without a seam. The duration scales with the number of marks, so
    adding one lengthens the loop instead of speeding it up.
  -->
  <div class="rule-thin py-6" aria-hidden="true">
    <div class="marquee" style={`--marquee-duration: ${TECH.length * 3}s`}>
      <div class="marquee-track">
        {[0, 1].map(() => (
          <div class="marquee-set">
            {TECH.map((tech) => <TechMark slug={tech.slug} class="h-6 w-auto sm:h-7" />)}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!--
  The listing, set as a paper sets its markets table, one category per tab.
  Same tab mechanism as the open courseware on Education (see Behaviors).
  The reversed bar is each panel's heading: it is what a reader without
  JavaScript sees above each category, and it goes screen-reader-only once
  the tabs take over, since the selected tab already names the category.
-->
<section class="px-5 pb-4 sm:px-8" data-tabs>
  <div
    class="tabs"
    data-tablist
    aria-label={t('stack.title')}
    style={`--tabs-per-row: ${tabsPerRow(categories.length)}`}
  >
    {categories.map((category) => (
      <a
        id={`stack-tab-${category.toLowerCase()}`}
        href={`#stack-${category.toLowerCase()}`}
        class="tab"
        data-tab={category.toLowerCase()}
        data-astro-reload
      >
        {t(`cat.${category}`)}
      </a>
    ))}
  </div>

  {
    categories.map((category) => {
      const items = TECH.filter((tech) => tech.category === category);

      return (
        <section
          id={`stack-${category.toLowerCase()}`}
          class="mt-6"
          data-tab-panel={category.toLowerCase()}
        >
          <div class="reversed flex items-baseline justify-between px-4 py-2" data-tab-heading>
            <h2 class="deck-sm">{t(`cat.${category}`)}</h2>
            <span class="kicker">
              {items.length} {t('stack.entries')}
            </span>
          </div>

          <ul>
            {items.map((raw) => {
              const tech = localize(raw, lang);
              return (
                <li data-reveal>
                  <button
                    type="button"
                    data-tech-open={tech.slug}
                    aria-haspopup="dialog"
                    class="listing-row cursor-pointer grid-cols-[4rem_1fr] gap-x-4 gap-y-1.5 px-3 py-4 sm:grid-cols-[5rem_13rem_1fr_1rem]"
                  >
                    <TechMark slug={tech.slug} class="h-7 w-auto max-w-full" />

                    <span class="deck-sm">{tech.name}</span>

                    <span class="col-start-2 text-sm leading-snug text-pretty sm:col-start-3">
                      {tech.tagline}
                    </span>

                    <span class="hidden text-right text-lg sm:block" aria-hidden="true">
                      ›
                    </span>
                  </button>
                </li>
              );
            })}
          </ul>

          <div class="rule-thin" />
        </section>
      );
    })
  }
</section>

{TECH.map((tech) => <TechDialog tech={tech} />)}
