---
import { getIcon } from '../lib/icons';
import type { Tech } from '../data/tech';

interface Props {
  tech: Tech;
  index: number;
  total: number;
}

const { tech, index, total } = Astro.props;
const icon = getIcon(tech.slug);

/*
  A few brand colours are effectively black (Rust, Kafka) and vanish against
  the night edition, so those follow the ink colour instead.
*/
const DARK_BRANDS = ['000000', '231F20'];
const color = DARK_BRANDS.includes(icon.hex) ? 'currentColor' : `#${icon.hex}`;

/*
  Scatter positions come from a jittered grid rather than true randomness:
  a coarse grid guarantees the logos never overlap, and the per-cell jitter
  stops it from reading as a grid. Deterministic, so the layout is stable
  across builds.
*/
const COLS = 5;
const rows = Math.ceil(total / COLS);
const col = index % COLS;
const row = Math.floor(index / COLS);

const jitterX = ((index * 37) % 11) - 5; // -5..5 percentage points
const jitterY = ((index * 53) % 11) - 5;

const x = ((col + 0.5) / COLS) * 100 + jitterX;
const y = ((row + 0.5) / rows) * 100 + jitterY;

// Varying the size adds depth and stops the scatter looking mechanical.
const size = 40 + ((index * 13) % 32);

// Drift parameters, again derived from the index so nothing moves in unison.
const dx = `${((index * 29) % 15) - 7}px`;
const dy = `${-(8 + ((index * 19) % 10))}px`;
const rot = `${((index * 41) % 7) - 3}deg`;
const rot2 = `${((index * 23) % 9) - 4}deg`;
const dur = `${9 + ((index * 17) % 6)}s`;
---

<button
  type="button"
  data-tech-open={tech.slug}
  data-drift
  aria-haspopup="dialog"
  aria-label={`Read what I think about ${tech.name}`}
  title={tech.name}
  style={`--x: ${x}%; --y: ${y}%; --size: ${size}px; --dx: ${dx}; --dy: ${dy}; --rot: ${rot}; --rot2: ${rot2}; --dur: ${dur}; --enter: ${index}`}
  class="logo-float cursor-pointer text-ink transition-opacity duration-300 hover:opacity-60"
>
  <svg
    viewBox="0 0 24 24"
    style={`color: ${color}; width: var(--size); height: var(--size)`}
    fill="currentColor"
    aria-hidden="true"
  >
    <path d={icon.path}></path>
  </svg>
</button>

<style>
  /*
    On narrow screens the logos simply flow as a wrapped row — absolute
    scatter in a short container would leave them too small to tap. From the
    small breakpoint up they take their scattered positions.
  */
  .logo-float {
    position: static;
  }

  @media (min-width: 640px) {
    .logo-float {
      position: absolute;
      left: var(--x);
      top: var(--y);
      translate: -50% -50%;
    }
  }
</style>
