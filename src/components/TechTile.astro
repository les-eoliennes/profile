---
import { getIcon } from '../lib/icons';
import type { Tech } from '../data/tech';

interface Props {
  tech: Tech;
  index: number;
}

const { tech, index } = Astro.props;
const icon = getIcon(tech.slug);

const DARK_BRANDS = ['000000', '231F20'];
const color = DARK_BRANDS.includes(icon.hex) ? 'currentColor' : `#${icon.hex}`;

const dx = `${((index * 37) % 5) - 2}px`;
const dy = `${-(3 + ((index * 23) % 3))}px`;
const dur = `${6 + ((index * 17) % 5)}s`;
---

<button
  type="button"
  data-tech-open={tech.slug}
  data-drift
  style={`--dx: ${dx}; --dy: ${dy}; --dur: ${dur}; --enter: ${index}`}
  aria-haspopup="dialog"
  class="card card-hover group flex aspect-square cursor-pointer flex-col items-center justify-center gap-3 p-4 text-ink"
>
  <svg
    viewBox="0 0 24 24"
    class="size-9 transition-transform duration-500 ease-out group-hover:scale-110 sm:size-11"
    style={`color: ${color}`}
    fill="currentColor"
    aria-hidden="true"
  >
    <path d={icon.path}></path>
  </svg>

  <span class="text-center text-xs leading-tight font-medium sm:text-sm">{tech.name}</span>
</button>
