---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
---

<button
  type="button"
  data-theme-toggle
  aria-label={t('a11y.theme')}
  class="kicker border border-rule px-2.5 py-1 transition-colors hover:bg-ink hover:text-paper"
>
  <span class="dark:hidden">{t('theme.toDark')}</span>
  <span class="hidden dark:inline">{t('theme.toLight')}</span>
</button>
