---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, EDUCATION, COURSEWORK, OPEN_COURSES, FOUNDATIONS } from '../consts';
---

<BaseLayout
  title={`Education — ${SITE.name}`}
  description="Shenzhen University, open courseware from MIT, Stanford and CMU, and the fundamentals behind the engineering."
>
  <section class="px-5 pt-9 sm:px-8">
    <p class="kicker text-center" data-enter style="--enter: 0">Section II</p>

    <h1 class="deck-xl mt-3 text-center text-balance" data-enter style="--enter: 1">
      Education
    </h1>

    <div class="rule-double mt-6"></div>

    <p
      class="standfirst mx-auto mt-6 max-w-2xl text-center text-pretty"
      data-enter
      style="--enter: 2"
    >
      A degree, then a habit of going back to the source material. The courses
      below are the ones that keep proving useful.
    </p>
  </section>

  <!-- The degree -->
  <section class="px-5 pt-10 sm:px-8">
    <div class="reversed px-4 py-2.5">
      <h2 class="deck-md">The Degree</h2>
    </div>

    {
      EDUCATION.map((item) => (
        <div class="mt-7 grid gap-6 lg:grid-cols-[1fr_1fr] lg:gap-12" data-reveal>
          <div>
            <p class="kicker">{item.period}</p>
            <h3 class="deck-lg mt-2">{item.school}</h3>
            <p class="standfirst mt-3">{item.degree}</p>
          </div>

          <div>
            <p class="dropcap text-sm leading-relaxed text-pretty">{item.detail}</p>
          </div>
        </div>
      ))
    }

    <div class="rule-thin mt-8 pt-6" data-reveal>
      <p class="kicker">Coursework</p>
      <ul class="mt-4 flex flex-wrap gap-x-2 gap-y-2">
        {
          COURSEWORK.map((course) => (
            <li class="cell px-3 py-1.5 text-sm">{course}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Open courseware -->
  <section class="px-5 pt-12 sm:px-8">
    <div class="reversed px-4 py-2.5">
      <h2 class="deck-md">Open Courseware</h2>
    </div>

    <p class="standfirst mt-5 max-w-3xl text-pretty" data-reveal>
      Worked through outside of work, in evenings and weekends. Lecture videos
      on their own do not stick — every course here was done with its problem
      sets and labs.
    </p>

    <div class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2">
      {
        OPEN_COURSES.map((course) => (
          <article class="rule-thin pt-5" data-reveal>
            <div class="flex items-baseline justify-between gap-4">
              <p class="kicker">
                {course.school} · {course.code}
              </p>
              <p class="byline">{course.year}</p>
            </div>

            <h3 class="deck-sm mt-2">{course.title}</h3>

            <p class="mt-3 text-sm leading-relaxed text-pretty">{course.note}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Fundamentals -->
  <section class="px-5 pt-12 sm:px-8">
    <div class="reversed px-4 py-2.5">
      <h2 class="deck-md">Fundamentals</h2>
    </div>

    <p class="standfirst mt-5 max-w-3xl text-pretty" data-reveal>
      Textbook knowledge only counts once it explains something you have seen in
      production. These are the parts that genuinely come up.
    </p>

    <div class="mt-8 columns-1 gap-10 sm:columns-2 lg:columns-3">
      {
        FOUNDATIONS.map((block) => (
          <div class="mb-8 break-inside-avoid" data-reveal>
            <h3 class="deck-sm">{block.area}</h3>
            <ul class="mt-3 space-y-2">
              {block.items.map((item) => (
                <li class="flex gap-2.5 text-sm leading-relaxed">
                  <span class="mt-2 h-px w-3 shrink-0 bg-ink" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="px-5 pt-8 sm:px-8">
    <div class="rule-double"></div>
    <div class="flex flex-wrap items-center justify-between gap-5 py-7">
      <h2 class="deck-md text-balance">See where the theory lands</h2>
      <div class="flex flex-wrap gap-3">
        <a href="/#work" class="btn-oval">The Work</a>
        <a href="/stack" class="btn-oval">The Stack</a>
      </div>
    </div>
  </section>
</BaseLayout>
