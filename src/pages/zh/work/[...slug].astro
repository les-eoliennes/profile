---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReportPage from '../../../components/ReportPage.astro';
import { SITE } from '../../../consts';
import { getReports, type Report } from '../../../lib/reports';

export async function getStaticPaths() {
  const reports = await getReports('zh');

  return reports.map((report, index) => ({
    params: { slug: report.slug },
    props: { report, index, next: reports[(index + 1) % reports.length] },
  }));
}

interface Props {
  report: Report;
  index: number;
  next: Report;
}

const { report, index, next } = Astro.props;
---

<BaseLayout
  title={`${report.entry.data.title} — ${SITE.name}`}
  description={report.entry.data.summary}
>
  <ReportPage entry={report.entry} index={index} next={next} />
</BaseLayout>
